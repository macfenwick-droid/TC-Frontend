# Server-only: FastAPI backend that /api/* is proxied to (see next.config.ts).
# Local backend: http://localhost:8000
API_PROXY_TARGET=https://ticket-cricket-be.onrender.com

zNEXT_PUBLIC_API_BASE_URL=/api

# Public site URL (canonical URLs, Google OAuth redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Google OAuth only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Search indexing. Leave unset everywhere except production AFTER the domain cutover.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Ads / GA4 / TikTok. Leave unset in dev and on the test deployment so no fake
# conversions are recorded. Set to "true" on production at the domain cutover.
# NEXT_PUBLIC_ENABLE_TRACKING=true
